GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-string
GITHUB_TOKEN=ghp_or_github_pat_with_pr_write

# OpenAI-compatible endpoint. Current setup is OpenRouter.
# LM Studio alternative: http://127.0.0.1:1234/v1
# (from Docker, use http://host.docker.internal:1234/v1)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-v1-your-openrouter-key
LLM_MODEL=qwen/qwen3-coder
# OpenRouter reserves credits against this cap. Qwen3-Coder defaults to 65536
# if unset, which 402s on a small balance.
LLM_MAX_TOKENS=4096

MAX_FILES=30
MAX_PATCH_CHARS=20000
LLM_TIMEOUT_SECONDS=180
REPOS_FILE=repos.yaml
ALLOW_UNREGISTERED=false
